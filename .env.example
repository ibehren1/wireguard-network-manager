# Copy to .env and fill in real values before running docker compose.

SECRET_KEY=change-me-to-a-random-value
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-a-fernet-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Automatic backup snapshots (optional; defaults shown).
# Format: "<day> <HH:MM>" in container local time (UTC unless TZ is set); "off" disables.
# BACKUP_SCHEDULE=sunday 00:00
# Number of snapshots kept in the ./backups bind mount; oldest are pruned.
# BACKUP_RETENTION=12
